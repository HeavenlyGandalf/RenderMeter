    "pug": "^3.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/mustache": "^4.2.5",
    "@types/pug": "^2.0.10",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-formatter-pretty": "^7.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
